const [editingProduct, setEditingProduct] = useState<Product | null>(null);
const [detailProduct, setDetailProduct] = useState<Product | null>(null);
const [showSearch, setShowSearch] = useState(false);
const [showOffersModal, setShowOffersModal] = useState(false);
const [imgSearchResults, setImgSearchResults] = useState<Product[] | null>(null);
const [imgSearchLoading, setImgSearchLoading] = useState(false);
const cameraInputRef = useRef<HTMLInputElement>(null);

useEffect(() => {
setState(loadState());
}, []);

useEffect(() => {
if (state) saveState(state);
}, [state]);

const updateState = useCallback((updater: (s: AppState) => AppState) => {
setState(prev => prev ? updater(prev) : prev);
}, []);

if (!state) {
return (
<div className="min-h-screen flex items-center justify-center">
<div className="animate-pulse text-2xl">VICKS MARKET</div>
</div>
);
}

const currentSeller = state.currentSellerId ? state.sellers[state.currentSellerId] ?? null : null;
const ownerMode = isOwner(currentSeller);

function handleLogin(seller: Seller) {
updateState(s => ({ ...s, currentSellerId: seller.id }));
setPage('seller');
}

function handleRegister(seller: Seller) {
updateState(s => ({ ...s, sellers: { ...s.sellers, [seller.id]: seller }, currentSellerId: seller.id }));
setPage('seller');
}

function handleLogout() {
updateState(s => ({ ...s, currentSellerId: null }));
setPage('home');
}

function handleLike(productId: string) {
if (!currentSeller) return;
updateState(s => {
const p = s.products[productId];
if (!p) return s;
const alreadyLiked = p.likedBy.includes(currentSeller.id);
const newLikedBy = alreadyLiked ? p.likedBy.filter(id => id !== currentSeller.id) : [...p.likedBy, currentSeller.id];
return { ...s, products: { ...s.products, [productId]: { ...p, likes: alreadyLiked ? p.likes - 1 : p.likes + 1, likedBy: newLikedBy } } };
});
}

function handleWhatsApp(product: Product) {
const seller = state.sellers[product.sellerId];
const phone = seller?.phone?.replace(/\D/g, '') ?? '201113694362';
const msg = encodeURIComponent(مرحباً، أنا مهتم بـ "${product.name}" بسعر ${product.price.toLocaleString('ar-EG')} ج.م);
window.open(https://wa.me/2${phone}?text=${msg}, '_blank');
}

function handleAddProduct(data: { name: string; price: number; category: string; emoji: string; description: string }) {
if (!currentSeller) return;
if (editingProduct) {
updateState(s => ({ ...s, products: { ...s.products, [editingProduct.id]: { ...s.products[editingProduct.id], ...data } } }));
} else {
const product = createProduct({ ...data, sellerId: currentSeller.id, sellerName: currentSeller.storeName });
updateState(s => ({
...s,
products: { ...s.products, [product.id]: product },
sellers: { ...s.sellers, [currentSeller.id]: { ...s.sellers[currentSeller.id], products: [...(s.sellers[currentSeller.id]?.products ?? []), product.id] } },
}));
}
setEditingProduct(null);
setPage('seller');
}

function handleDeleteProduct(productId: string) {
if (!currentSeller) return;
if (!confirm('هل تريد حذف هذا المنتج؟')) return;
updateState(s => {
const newProducts = { ...s.products };
delete newProducts[productId];
const newSellers = { ...s.sellers };
if (newSellers[currentSeller.id]) {
newSellers[currentSeller.id] = { ...newSellers[currentSeller.id], products: newSellers[currentSeller.id].products.filter(id => id !== productId) };
}
return { ...s, products: newProducts, sellers: newSellers };
});
}

function handleSendMessage(text: string) {
updateState(s => {
let ns = addChatMessage(s, { role: 'user', text });
ns = addChatMessage(ns, { role: 'bot', text: getBotResponse(text) });
return ns;
});
}

function handlePurchaseComplete(type: string, _amount: number, pts?: number) {
if (!currentSeller) return;
updateState(s => {
const seller = s.sellers[currentSeller.id];
if (!seller) return s;
return { ...s, sellers: { ...s.sellers, [currentSeller.id]: { ...seller, points: seller.points + (pts ?? 0), verified: type === 'verify' ? true : seller.verified } } };
});
}

function handleCameraSearch(e: React.ChangeEvent<HTMLInputElement>) {
const file = e.target.files?.[0];
if (!file) return;
setImgSearchLoading(true);
setImgSearchResults(null);
setTimeout(() => {
const shuffled = [...Object.values(state.products)].sort(() => Math.random() - 0.5);
setImgSearchResults(shuffled);
setImgSearchLoading(false);
}, 1800);
if (cameraInputRef.current) cameraInputRef.current.value = '';
}

function handleAccountBtn() {
if (currentSeller) { setPage('seller'); } else { setPage('login'); }
}

function showHome() {
setPage('home');
setDetailProduct(null);
setEditingProduct(null);
setImgSearchResults(null);
}

const isLiked = (p: Product) => currentSeller ? p.likedBy.includes(currentSeller.id) : false;
const isHome = page === 'home';
const offersProducts = Object.values(state.products).filter(p => p.likes > 0 || p.price < 300);

return (
<div className={min-h-screen flex flex-col ${ownerMode ? 'ring-2 ring-yellow-400 ring-inset' : ''}`}>
{isHome && (
<>
{/* Header /}
<header className="sticky top-0 z-20 bg-card border-b border-border px-4 py-3" dir="ltr">
<div className="flex items-center justify-between">
{/ Left side - Logo and Name */}
<div className="flex items-center gap-2">
<img src="/logo.png" alt="VICKS MARKET" className="h-9 w-9 object-contain" />
<h1 className="text-lg font-bold text-primary">VICKS MARKET</h1>
</div>

{/* Right side - Search icons /}
<div className="flex items-center gap-2">
<button
className={p-2 rounded-lg transition-colors${imgSearchLoading ? 'bg-primary/10 text-primary' : 'hover:bg-muted'}`}
onClick={() => cameraInputRef.current?.click()}
title="بحث بصورة المنتج"
>
{imgSearchLoading ? (
<div className="h-5 w-5 animate-spin rounded-full border-2 border-primary border-t-transparent" />
) : (
<Camera className="h-5 w-5" />
)}
</button>
<button
className="p-2 rounded-lg hover:bg-muted transition-colors"
onClick={() => { setShowSearch(s => !s); setImgSearchResults(null); }}
title="بحث"
>
<Search className="h-5 w-5" />
