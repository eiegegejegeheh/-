</div>
<input
ref={cameraInputRef}
type="file"
accept="image/"
capture="environment"
className="hidden"
onChange={handleCameraSearch}
/>
</div>

{showSearch && (
<div className="mt-3">
<div className="relative">
<Search className="absolute right-3 top-1/2 -translate-y-1/2 h-4 w-4 text-muted-foreground" />
<input
type="text"
placeholder="ابحث عن منتج..."
className="w-full px-4 py-2.5 pr-10 rounded-xl bg-muted border-0 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20"
autoFocus
/>
</div>
</div>
)}

{imgSearchLoading && (
<div className="mt-3 px-4 py-2 bg-primary/10 rounded-xl text-sm text-primary font-medium">
جاري البحث عن منتجات مشابهة...
</div>
