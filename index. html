interface HomePageProps {
products: Record<string, Product>;
currentSellerId: string | null;
isLoggedIn: boolean;
onLike: (productId: string) => void;
onWhatsApp: (product: Product) => void;
onProductClick: (product: Product) => void;
onAccountBtn: () => void;
onShowOffers: () => void;
imgSearchResults: Product[] | null;
onClearImgSearch: () => void;
}

export function HomePage({ products, currentSellerId, isLoggedIn, onLike, onWhatsApp, onProductClick, onAccountBtn, onShowOffers, imgSearchResults, onClearImgSearch }: HomePageProps) {
const [category, setCategory] = useState<Category>('all');
const [viewMode, setViewMode] = useState<ViewMode>('grid');

const CATEGORIES: { id: Category; label: string }[] = [
{ id: 'all', label: 'الكل' },
{ id: 'used', label: 'مستعمل' },
{ id: 'screens', label: 'سوبر ماركت' },
{ id: 'new', label: 'جمال وعناية' },
{ id: 'offers', label: 'عروض' },
 ];

const filtered = useMemo(() => {
return Object.values(products)
.filter(p => {
if (category === 'offers') return p.likes > 0 || p.price < 300;
if (category !== 'all' && p.category !== category) return false;
return true;
})
.sort((a, b) => b.createdAt - a.createdAt);
}, [products, category]);

const isLiked = (p: Product) => currentSellerId ? p.likedBy.includes(currentSellerId) : false;
const displayProducts = imgSearchResults ?? filtered;
const isImgMode = imgSearchResults !== null;

return (
<div className="flex flex-col h-full">
