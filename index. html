function getDefaultState(): AppState {
const sellers = { ...SAMPLE_SELLERS };
sellers['owner'].products = Object.keys(SAMPLE_PRODUCTS);
return {
sellers,
products: SAMPLE_PRODUCTS,
currentSellerId: null,
chatMessages: [{ id: '1', role: 'bot', text: 'أهلاً بك في VICKS MARKET! كيف أستطيع مساعدتك اليوم؟', ts: Date.now() - 1000 }],
notifications: [],
};
}

export function loadState(): AppState {
if (typeof window === 'undefined') return getDefaultState();
try {
const raw = localStorage.getItem(STORAGE_KEY);
if (!raw) return getDefaultState();
const parsed = JSON.parse(raw) as AppState;
if (!parsed.sellers || !parsed.products) return getDefaultState();
return parsed;
} catch { return getDefaultState(); }
}

export function saveState(state: AppState): void {
if (typeof window === 'undefined') return;
localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
}

export function isOwner(seller: Seller | null): boolean {
return seller?.email === OWNER_EMAIL;
}

export function generateSellerId(): string { return 's_' + generateId(); }

export function createSeller(data: { email: string; password: string; storeName: string; ownerName: string; phone: string; district: string }): Seller {
return { id: generateSellerId(), ...data, points: 0, verified: false, subscription: 'free', products: [], createdAt: Date.now() };
}

export function createProduct(data: { name: string; price: number; category: string; emoji: string; description: string; sellerId: string; sellerName: string }): Product {
return { id: 'p_' + generateId(), ...data, likes: 0, likedBy: [], createdAt: Date.now() };
}

export function addChatMessage(state: AppState, msg: Omit<ChatMessage, 'id' | 'ts'>): AppState {
const message: ChatMessage = { ...msg, id: generateId(), ts: Date.now() };
return { ...state, chatMessages: [...state.chatMessages, message] };
}

export function getBotResponse(userMsg: string): string {
const msg = userMsg.toLowerCase();
if (msg.includes('سعر') || msg.includes('price')) return 'يمكنك الاطلاع على أسعار جميع المنتجات في الصفحة الرئيسية. هل تريد البحث عن منتج معين؟';
if (msg.includes('تسجيل') || msg.includes('بائع') || msg.includes('انضم')) return 'للانضمام كبائع، اضغط على "حسابي" ثم "انضم كتاجر جديد". التسجيل مجاني!';
if (msg.includes('نقاط') || msg.includes('point')) return 'يمكنك شراء النقاط من متجر VICKS. النقاط تُستخدم لرفع منتجاتك ومميزات أخرى';
if (msg.includes('توثيق') || msg.includes('شارة')) return 'علامة التوثيق تُظهر للعملاء أنك بائع موثوق وتزيد مبيعاتك. سعرها 150 ج.م مرة واحدة فقط!';
if (msg.includes('اشتراك') || msg.includes('باقة')) return 'لدينا ثلاث باقات: مجاني (10 منتجات)، فضي 99 ج.م (50 منتج)، ذهبي 199 ج.م (غير محدود)';
if (msg.includes('مرحب') || msg.includes('هلا') || msg.includes('أهلا') || msg.includes('هاي')) return 'أهلاً وسهلاً! أنا مساعد VICKS MARKET. كيف يمكنني مساعدتك؟';
if (msg.includes('شكر')) return 'العفو! دائماً في خدمتك';
return 'شكراً لتواصلك! يمكنني مساعدتك في البحث عن منتجات، التسجيل كبائع، أو أي استفسار آخر';
}
