onGoJoin: () => void;
onBack: () => void;
}

export function LoginPage({ sellers, onLogin, onGoJoin, onBack }: LoginPageProps) {
const [email, setEmail] = useState('');
const [password, setPassword] = useState('');
const [mfaInput, setMfaInput] = useState('');
const [pendingSeller, setPendingSeller] = useState<Seller | null>(null);
const [showMfa, setShowMfa] = useState(false);
const [showForgotPassword, setShowForgotPassword] = useState(false);
const [resetEmail, setResetEmail] = useState('');
const [resetSent, setResetSent] = useState(false);
const [error, setError] = useState('');

function doLogin() {
setError('');
const seller = Object.values(sellers).find(s => s.email === email.trim() && s.password === password);
if (!seller) {
setError('البريد الإلكتروني أو كلمة المرور غير صحيحة');
return;
}
if (seller.mfaCode) {
setPendingSeller(seller);
setShowMfa(true);
} else {
onLogin(seller);
}
}

function doMFA() {
if (!pendingSeller) return;
if (mfaInput.trim() === pendingSeller.mfaCode) {
onLogin(pendingSeller);
} else {
setError('رمز التحقق غير صحيح');
}
}

function doResetPassword() {
setError('');
if (!resetEmail.trim()) {
setError('يرجى إدخال البريد الإلكتروني');
return;
}
const seller = Object.values(sellers).find(s => s.email === resetEmail.trim());
if (!seller) {
setError('هذا البريد الإلكتروني غير مسجل');
return;
}
setResetSent(true);
}

return (
<div className="flex flex-col h-full bg-background">
