<div className="max-w-md mx-auto space-y-4">
{error && (
<div className="bg-red-50 text-red-600 px-4 py-3 rounded-xl text-sm font-medium">
{error}
</div>
)}

<div className="space-y-2">
<label className="text-sm font-medium">البريد الإلكتروني</label>
