dir="ltr"
/>
</div>
</div>

<div className="space-y-2">
<label className="text-sm font-medium">كلمة المرور</label>
<div className="relative">
<Lock className="absolute right-3 top-1/2 -translate-y-1/2 h-5 w-5 text-muted-foreground" />
<input
type="password"
value={password}
onChange={e => setPassword(e.target.value)}
placeholder="كلمة المرور"
className="w-full px-4 py-3 pr-11 rounded-xl bg-muted border-0 text-sm focus:outline-none focus:ring-2 focus:ring-primary/20"
onKeyDown={e => e.key === 'Enter' && doLogin()}
/>
</div>
</div>

<button
className="w-full py-3 rounded-xl bg-primary text-primary-foreground font-semibold hover:bg-primary/90 transition-colors"
onClick={doLogin}
>
دخول
</button>

<button
className="w-full text-sm text-primary hover:underline"
onClick={() => { setShowForgotPassword(true); setError(''); setResetSent(false); setResetEmail(''); }}
>
نسيت كلمة السر؟
</button>

{showMfa && (
<div className="p-4 bg-orange-50 rounded-xl space-y-3">
<div className="flex items-center gap-2 text-sm font-semibold text-orange-600">
<Shield className="h-4 w-4" />
